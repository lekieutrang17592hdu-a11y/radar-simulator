  function worldToScreen(wx, wy) {
    return {
      x: view.offsetX + wx * view.scale,
      y: view.offsetY - wy * view.scale
    };
  }

  function screenToWorld(sx, sy) {
    return {
      x: (sx - view.offsetX) / view.scale,
      y: (view.offsetY - sy) / view.scale
    };
  }

  function resetView() {
    const padding = 55;
    const availW = canvas.width - padding * 2;
    const availH = canvas.height - padding * 2;
    view.scale = Math.min(availW / gridMax, availH / gridMax);
    view.offsetX = padding + (availW - gridMax * view.scale) / 2;
    view.offsetY = canvas.height - padding - (availH - gridMax * view.scale) / 2;
  }

  function zoomCanvas(factor, centerX = canvas.width / 2, centerY = canvas.height / 2) {
    const worldBefore = screenToWorld(centerX, centerY);
    view.scale *= factor;
    const screenAfter = worldToScreen(worldBefore.x, worldBefore.y);
    view.offsetX += (centerX - screenAfter.x);
    view.offsetY += (centerY - screenAfter.y);
  }

  function focusIntersection() {
    const pts = getAllPairIntersections();
    let focusX = targetPos.x;
    let focusY = targetPos.y;
    if (pts.length > 0) {
      let bestPt = pts[0];
      let minSumDist = Infinity;
      for (let p of pts) {
        let sum = 0;
        for (let q of pts) {
          sum += Math.hypot(p.x - q.x, p.y - q.y);
        }
        if (sum < minSumDist) {
          minSumDist = sum;
          bestPt = p;
        }
      }
      focusX = bestPt.x;
      focusY = bestPt.y;
    }
    const span = gridMax > 100 ? 6 : 4;
    view.scale = Math.min(canvas.width, canvas.height) / span;
    view.offsetX = canvas.width / 2 - focusX * view.scale;
    view.offsetY = canvas.height / 2 + focusY * view.scale;
  }

  function getCircleIntersections(c1, c2) {
    if (c1.r <= 0 || c2.r <= 0) return [];
    const dx = c2.x - c1.x;
    const dy = c2.y - c1.y;
    const d = Math.hypot(dx, dy);
    if (d > c1.r + c2.r || d < Math.abs(c1.r - c2.r) || d === 0) return [];

    const a = (c1.r * c1.r - c2.r * c2.r + d * d) / (2 * d);
    const h = Math.sqrt(Math.max(0, c1.r * c1.r - a * a));
    const x2 = c1.x + (a * dx) / d;
    const y2 = c1.y + (a * dy) / d;
    const rx = (-dy * h) / d;
    const ry = (dx * h) / d;

    if (h === 0) return [{ x: x2, y: y2 }];
    return [
      { x: x2 + rx, y: y2 + ry },
      { x: x2 - rx, y: y2 - ry }
    ];
  }

  function getAllPairIntersections() {
    return [
      ...getCircleIntersections(stations.a, stations.b),
      ...getCircleIntersections(stations.b, stations.c),
      ...getCircleIntersections(stations.a, stations.c)
    ];
  }

