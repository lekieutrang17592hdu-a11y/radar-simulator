      document.getElementById('distCInfo').innerText = `R_C = ${chosen[2].r} km`;

      document.getElementById('missionDesc').innerHTML = `
        <strong>🎲 CA CỨU HỘ NGẪU NHIÊN (SỐ NGUYÊN):</strong><br>
        • Trạm <code>A(${chosen[0].x}; ${chosen[0].y})</code> cách <code>${chosen[0].r} km</code><br>
        • Trạm <code>B(${chosen[1].x}; ${chosen[1].y})</code> cách <code>${chosen[1].r} km</code><br>
        • Trạm <code>C(${chosen[2].x}; ${chosen[2].y})</code> cách <code>${chosen[2].r} km</code><br>
        Kéo thanh trượt bán kính để khoanh vùng và khóa tọa độ nạn nhân!
      `;
    } else {
      // Hill / Decimal mode (400x400)
      gridMax = 400;
      tolerance = 2.0;
      const tx = Math.floor(Math.random() * 200) + 100;
      const ty = Math.floor(Math.random() * 200) + 100;
      targetPos = { x: tx, y: ty };

      const stCoords = [
        { x: Math.floor(Math.random() * 80) + 30, y: Math.floor(Math.random() * 100) + 40, h: 30 },
        { x: Math.floor(Math.random() * 80) + 290, y: Math.floor(Math.random() * 100) + 40, h: 45 },
        { x: Math.floor(Math.random() * 160) + 120, y: Math.floor(Math.random() * 70) + 300, h: 60 }
      ];

      const dList = stCoords.map(st => {
        const rTrue = Math.hypot(tx - st.x, ty - st.y);
        const dSlant = Math.hypot(rTrue, st.h);
        return Number(dSlant.toFixed(1));
      });

      stations.a = { x: stCoords[0].x, y: stCoords[0].y, r: 0, color: '#ef4444', label: 'A' };
      stations.b = { x: stCoords[1].x, y: stCoords[1].y, r: 0, color: '#3b82f6', label: 'B' };
      stations.c = { x: stCoords[2].x, y: stCoords[2].y, r: 0, color: '#10b981', label: 'C' };

