  // Generate Unlimited Random Missions
  function generateRandomMission(type) {
    resetAttemptUI();
    if (type === 'int') {
      gridMax = 24;
      tolerance = 0.4;
      // Pick secret target safely inside [6..18]
      const tx = Math.floor(Math.random() * 11) + 7;
      const ty = Math.floor(Math.random() * 11) + 7;
      targetPos = { x: tx, y: ty };

      // Pick 3 distinct non-collinear stations with integer radii
      let chosen = [];
      let attempts = 0;
      while (chosen.length < 3 && attempts < 200) {
        attempts++;
        const vec = pythagoreanVectors[Math.floor(Math.random() * pythagoreanVectors.length)];
        const sx = tx + vec[0];
        const sy = ty + vec[1];
        const r = vec[2];
        if (sx >= 1 && sx <= 23 && sy >= 1 && sy <= 23) {
          const dup = chosen.some(s => Math.hypot(s.x - sx, s.y - sy) < 5);
          if (!dup) {
            if (chosen.length === 2) {
              // Check non-collinear area
              const area = Math.abs((chosen[1].x - chosen[0].x)*(sy - chosen[0].y) - (sx - chosen[0].x)*(chosen[1].y - chosen[0].y));
              if (area < 15) continue;
            }
            chosen.push({ x: sx, y: sy, r: r });
          }
        }
      }
      // Fallback if needed
      if (chosen.length < 3) {
        targetPos = { x: 12, y: 11 };
        chosen = [
          { x: 9, y: 7, r: 5 },
          { x: 20, y: 17, r: 10 },
          { x: 7, y: 23, r: 13 }
        ];
      }

      stations.a = { x: chosen[0].x, y: chosen[0].y, r: 0, color: '#ef4444', label: 'A' };
      stations.b = { x: chosen[1].x, y: chosen[1].y, r: 0, color: '#3b82f6', label: 'B' };
