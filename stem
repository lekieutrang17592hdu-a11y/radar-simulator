<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Radar Trilateration Simulator - Mật Mã GPS (THCS Lạc Long Quân)</title>
<style>
  :root {
    --bg-dark: #0a1118;
    --panel-bg: #111d29;
    --border-color: #1e354d;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --accent-cyan: #06b6d4;
    --accent-green: #10b981;
    --accent-red: #ef4444;
    --accent-blue: #3b82f6;
    --accent-yellow: #f59e0b;
    --accent-purple: #a855f7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
  body { background-color: var(--bg-dark); color: var(--text-main); display: flex; flex-direction: column; min-height: 100vh; overflow-x: hidden; }
  
  /* Header */
  header {
    background: linear-gradient(90deg, #0d1926 0%, #162a3d 100%);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .title-box h1 { font-size: 1.2rem; color: var(--accent-cyan); letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px; }
  .title-box p { font-size: 0.8rem; color: var(--text-muted); }
  .mode-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
  .tab-btn {
    background-color: #162636; color: var(--text-main); border: 1px solid var(--border-color);
    padding: 8px 13px; border-radius: 6px; cursor: pointer; font-size: 0.83rem; font-weight: 600; transition: all 0.2s;
  }
  .tab-btn:hover { border-color: var(--accent-cyan); }
  .tab-btn.active { background-color: var(--accent-cyan); color: #05131c; border-color: var(--accent-cyan); }
  .tab-btn.random-tab.active { background-color: var(--accent-purple); color: #fff; border-color: var(--accent-purple); }

  /* Main Layout */
  .main-container {
    display: grid;
    grid-template-columns: 350px 1fr 350px;
    gap: 16px;
    padding: 16px;
    flex: 1;
  }
  @media (max-width: 1200px) { .main-container { grid-template-columns: 1fr; } }

  .panel {
    background-color: var(--panel-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .panel-title {
    font-size: 0.92rem; font-weight: 700; color: var(--accent-cyan);
    text-transform: uppercase; border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px; display: flex; justify-content: space-between; align-items: center;
  }

  /* Station Controls */
  .station-card {
    background-color: #0d1722; border-left: 4px solid #fff; border-radius: 6px;
    padding: 10px 12px; display: flex; flex-direction: column; gap: 8px;
  }
  .station-a { border-left-color: var(--accent-red); }
  .station-b { border-left-color: var(--accent-blue); }
  .station-c { border-left-color: var(--accent-green); }
  .station-header { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 0.88rem; }
  .coord-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .input-group { display: flex; flex-direction: column; gap: 3px; }
  .input-group label { font-size: 0.74rem; color: var(--text-muted); }
  input[type="number"] {
    background-color: #162433; border: 1px solid var(--border-color); color: #fff;
    padding: 6px 8px; border-radius: 4px; font-size: 0.85rem; width: 100%;
  }
  input[type="number"]:focus { outline: none; border-color: var(--accent-cyan); }
  .slider-row { display: flex; align-items: center; gap: 8px; }
  input[type="range"] { flex: 1; accent-color: var(--accent-cyan); cursor: pointer; }
  .radius-val-input { width: 72px !important; text-align: right; font-weight: 700; }

  /* Canvas Area */
  .canvas-wrapper {
    position: relative; background-color: #060c12; border: 1px solid var(--border-color);
    border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; min-height: 540px;
  }
  canvas { width: 100%; height: 100%; flex: 1; cursor: crosshair; display: block; }
  .canvas-toolbar {
    position: absolute; top: 12px; right: 12px; display: flex; gap: 6px;
    background: rgba(17, 29, 41, 0.85); padding: 6px; border-radius: 8px;
    border: 1px solid var(--border-color); backdrop-filter: blur(4px); flex-wrap: wrap;
  }
  .tool-btn {
    background: #1a2d40; color: var(--text-main); border: 1px solid var(--border-color);
    padding: 6px 10px; border-radius: 5px; cursor: pointer; font-size: 0.78rem; font-weight: 600;
  }
  .tool-btn:hover { background: var(--accent-cyan); color: #05131c; }
  .cursor-hud {
    position: absolute; bottom: 12px; left: 12px;
    background: rgba(10, 17, 24, 0.85); border: 1px solid var(--border-color);
    padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-family: monospace; color: var(--accent-cyan);
    pointer-events: none;
  }

  /* Target Lock Panel */
  .mission-box {
    background-color: #0d1722; border: 1px dashed var(--accent-yellow);
    border-radius: 6px; padding: 10px; font-size: 0.82rem; line-height: 1.5; color: #fef3c7;
  }
  .mission-box code {
    background: rgba(255,255,255,0.1); padding: 1px 5px; border-radius: 3px; color: #38bdf8; font-weight: bold;
  }
  .random-controls {
    display: none; grid-template-columns: 1fr 1fr; gap: 8px;
  }
  .random-controls.show { display: grid; }
  .btn-gen {
    background: linear-gradient(90deg, #7e22ce 0%, #9333ea 100%);
    color: #fff; border: none; padding: 9px 10px; border-radius: 6px;
    font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: opacity 0.2s;
  }
  .btn-gen.alt { background: linear-gradient(90deg, #0284c7 0%, #0ea5e9 100%); }
  .btn-gen:hover { opacity: 0.9; }

  .lock-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .btn-lock {
    grid-column: span 2; background: linear-gradient(90deg, #dc2626 0%, #ef4444 100%);
    color: white; border: none; padding: 11px; border-radius: 6px;
    font-size: 0.92rem; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3); transition: transform 0.1s;
  }
  .btn-lock:active { transform: scale(0.98); }

  .status-banner { padding: 11px; border-radius: 6px; font-size: 0.83rem; line-height: 1.45; display: none; }
  .status-success { display: block; background-color: rgba(16, 185, 129, 0.15); border: 1px solid var(--accent-green); color: #a7f3d0; animation: pulseGreen 1.5s infinite; }
  .status-fail { display: block; background-color: rgba(239, 68, 68, 0.15); border: 1px solid var(--accent-red); color: #fecaca; }
  @keyframes pulseGreen {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  /* Log Table */
  .log-container { max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 6px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.77rem; }
  th, td { padding: 6px 8px; text-align: center; border-bottom: 1px solid var(--border-color); }
  th { background-color: #162636; color: var(--accent-cyan); position: sticky; top: 0; }
  .badge-ok { background-color: var(--accent-green); color: #05131c; padding: 2px 6px; border-radius: 4px; font-weight: 700; }
  .badge-err { background-color: var(--accent-red); color: #fff; padding: 2px 6px; border-radius: 4px; font-weight: 700; }

  .custom-target-box {
    display: none; background: #162433; padding: 10px; border-radius: 6px;
    border: 1px solid var(--accent-cyan); gap: 8px; flex-direction: column;
  }
  .custom-target-box.show { display: flex; }
  .checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--text-muted); }
</style>
</head>
<body>

<header>
  <div class="title-box">
    <h1>📡 RADAR TRILATERATION SIMULATOR</h1>
    <p>Chủ đề STEM Toán 9: “Mật Mã GPS – Toán Học Đằng Sau Hệ Thống Định Vị” | Trường THCS Lạc Long Quân</p>
  </div>
  <div class="mode-tabs">
    <button class="tab-btn active" onclick="setMode('level1', this)">Thẻ SOS Cấp 1 (Mẫu)</button>
    <button class="tab-btn" onclick="setMode('level2', this)">Thẻ SOS Cấp 2 (Đỉnh đồi)</button>
    <button class="tab-btn random-tab" onclick="setMode('random', this)">🎲 Tạo Đề Ngẫu Nhiên</button>
    <button class="tab-btn" onclick="setMode('custom', this)">⚙️ GV Tự Nhập Đề</button>
  </div>
</header>

<div class="main-container">
  <!-- Left Panel: Station Controls -->
  <div class="panel">
    <div class="panel-title">
      <span>1. Dữ Liệu 3 Trạm Thu Phát Sóng</span>
      <span id="unitLabel" style="font-size: 0.74rem; color: #94a3b8;">1 đơn vị = 1 km</span>
    </div>

    <!-- Station A -->
    <div class="station-card station-a">
      <div class="station-header" style="color: #f87171;">
        <span>🔴 TRẠM A (Đỏ)</span>
        <span id="distAInfo">R_A = 5 km</span>
      </div>
      <div class="coord-inputs">
        <div class="input-group">
          <label>Tọa độ X_A</label>
          <input type="number" id="ax" step="any" onchange="updateFromInputs()">
        </div>
        <div class="input-group">
          <label>Tọa độ Y_A</label>
          <input type="number" id="ay" step="any" onchange="updateFromInputs()">
        </div>
      </div>
      <div class="input-group">
        <label>Bán kính mặt đất R_A</label>
        <div class="slider-row">
          <input type="range" id="arSlider" min="0" max="30" step="0.1" oninput="syncSlider('a', this.value)">
          <input type="number" id="arNum" step="0.1" class="radius-val-input" onchange="syncNum('a', this.value)">
        </div>
      </div>
    </div>

    <!-- Station B -->
    <div class="station-card station-b">
      <div class="station-header" style="color: #60a5fa;">
        <span>🔵 TRẠM B (Xanh dương)</span>
        <span id="distBInfo">R_B = 12 km</span>
      </div>
      <div class="coord-inputs">
        <div class="input-group">
          <label>Tọa độ X_B</label>
          <input type="number" id="bx" step="any" onchange="updateFromInputs()">
        </div>
        <div class="input-group">
          <label>Tọa độ Y_B</label>
          <input type="number" id="by" step="any" onchange="updateFromInputs()">
        </div>
      </div>
      <div class="input-group">
        <label>Bán kính mặt đất R_B</label>
        <div class="slider-row">
          <input type="range" id="brSlider" min="0" max="30" step="0.1" oninput="syncSlider('b', this.value)">
          <input type="number" id="brNum" step="0.1" class="radius-val-input" onchange="syncNum('b', this.value)">
        </div>
      </div>
    </div>

    <!-- Station C -->
    <div class="station-card station-c">
      <div class="station-header" style="color: #34d399;">
        <span>🟢 TRẠM C (Xanh lá)</span>
        <span id="distCInfo">R_C = 12 km</span>
      </div>
      <div class="coord-inputs">
        <div class="input-group">
          <label>Tọa độ X_C</label>
          <input type="number" id="cx" step="any" onchange="updateFromInputs()">
        </div>
        <div class="input-group">
          <label>Tọa độ Y_C</label>
